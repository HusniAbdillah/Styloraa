{
  "name": "stylora",
  "version": "0.1.0",
  "description": "Stylora shared-demo starter: Next.js and Supabase",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:turbopack": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "db:start": "node scripts/run-supabase.mjs start",
    "db:stop": "node scripts/run-supabase.mjs stop",
    "db:reset": "node scripts/run-supabase.mjs db reset --local",
    "db:test": "node scripts/run-supabase.mjs test db",
    "db:types": "node scripts/generate-db-types.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HusniAbdillah/Styloraa.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/HusniAbdillah/Styloraa/issues"
  },
  "homepage": "https://github.com/HusniAbdillah/Styloraa#readme",
  "dependencies": {
    "@hookform/resolvers": "6.0.2",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "2.1.1",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "next": "16.4.3",
    "openai": "7.47.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "packageManager": "pnpm@10.26.2"
}
