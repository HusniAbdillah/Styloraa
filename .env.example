# Server configuration template. Copy to the Git-ignored .env.local.
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_SECRET_KEY=
MODEL_API_KEY=
STYLORA_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
# Disabled until the deployment has a migrated database and accepts shared demo edits.
DEMO_WRITES_ENABLED=false

# CLI-only credentials. Never commit real values.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Meta text provider for capsule combinations (server-only, optional).
# Without META_API_KEY + META_TEXT_MODEL, AI combinations return 503 and the
# manual builder stays available. Visual try-on uses a separate provider.
META_API_KEY=
META_API_BASE_URL=https://api.llama.com/compat/v1
META_TEXT_MODEL=
