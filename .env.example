# Server configuration template. Copy to the Git-ignored .env.local.
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_SECRET_KEY=
MODEL_API_KEY=
STYLORA_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
# Disabled until the deployment has a migrated database and accepts shared demo edits.
DEMO_WRITES_ENABLED=false

# CLI-only credentials. Never commit real values.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# MODEL_API_KEY powers Muse Spark 1.3 text and Muse Image 1.0 visual previews.
# Same credential and https://api.meta.ai/v1 endpoint as the inspiration flow.
# No separate Llama/META_* configuration is used.

# Marketplace provider configuration (server-only).
SERPAPI_API_KEY=
